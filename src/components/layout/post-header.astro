---
import { format } from 'date-fns';
import PostTags from './post-tags.astro';

interface Props {
  class?: string;
  title: string;
  date: Date | string | number;
  readingTime?: string;
  tags?: string[];
}

const { class: className, title, date, readingTime, tags = [] } = Astro.props;
---

<div class={className}>
  <h1 class="font-display text-5xl font-bold">{title}</h1>
  <div class="text-text-2">
    <span>{format(date, 'MMM dd, yyyy')}</span>
    {readingTime && <span>· {readingTime}</span>}
  </div>
  {tags.length > 0 && <PostTags {tags} class="mt-4" />}
</div>
