---
import { cfg } from '~/cfg';
import BaseLayout from '~/components/layout/base-layout.astro';
import BaseBio from '~/components/layout/base-bio.astro';
import { getPostsCollection, getTags } from '~/lib/mdx/post';
import PostList from '~/components/post-list';
import ThemeToggle from '~/components/ui/theme-toggle.astro';

const posts = await getPostsCollection();
const tags = getTags(posts);
---

<BaseLayout>
  <div class="mb-10 flex items-center justify-between gap-2">
    <h1 class="font-display text-4xl font-bold">{cfg.title}</h1>
    <ThemeToggle />
  </div>
  <BaseBio class="mt-0 mb-14" />
  <PostList client:load posts={posts} tags={tags} />
</BaseLayout>
